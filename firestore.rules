rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Shop hours are 09:00-21:00 Asia/Kolkata.
    // Firestore request.time uses UTC: 03:30 inclusive to 15:30 exclusive.
    function isWithinShopHours() {
      return (request.time.hours() > 3 && request.time.hours() < 15) ||
        (request.time.hours() == 3 && request.time.minutes() >= 30) ||
        (request.time.hours() == 15 && request.time.minutes() < 30);
    }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /app_config/update {
      allow read: if true;
      allow write: if false;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /menu/{productId} {
      allow read: if signedIn();
      allow create: if isAdmin() || (signedIn() &&
        exists(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.active == true &&
        request.resource.data.partnerId == get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.partnerId &&
        request.resource.data.partnerName == get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.partnerName);
      allow update: if isAdmin() || (signedIn() &&
        exists(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.active == true &&
        resource.data.partnerId == get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.partnerId &&
        resource.data.partnerName == get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.partnerName &&
        request.resource.data.partnerId == resource.data.partnerId &&
        request.resource.data.partnerName == resource.data.partnerName);
      allow delete: if isAdmin() || (signedIn() &&
        exists(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.active == true &&
        resource.data.partnerId == get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.partnerId &&
        resource.data.partnerName == get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.partnerName);
    }
    match /deliveryBoys/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }
    match /partnerApplications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.approved == false
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 1
        && request.resource.data.ownerName is string
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{10}$')
        && request.resource.data.city is string
        && request.resource.data.state is string
        && request.resource.data.pincode is string
        && request.resource.data.pincode.matches('^[0-9]{6}$');
      allow read, update, delete: if isAdmin();
    }
    match /partners/{partnerId} {
      allow read: if (resource.data.approved == true && resource.data.active == true) || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    match /partnerAccounts/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }
    match /partnerProductChanges/{changeId} {
      allow create: if signedIn() &&
        exists(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.active == true &&
        request.resource.data.partnerId == get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.partnerId &&
        request.resource.data.partnerName == get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.partnerName &&
        request.resource.data.status == 'pending';
      allow read: if isAdmin() ||
        (signedIn() && resource.data.partnerId == get(/databases/$(database)/documents/partnerAccounts/$(request.auth.uid)).data.partnerId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if isWithinShopHours()
        && signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'New'
        && request.resource.data.paymentMethod in ['COD', 'UPI'];
      allow read: if isAdmin() ||
        (signedIn() && resource.data.customerUid == request.auth.uid) ||
        (signedIn() && resource.data.deliveryBoyUid == request.auth.uid &&
          exists(/databases/$(database)/documents/deliveryBoys/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/deliveryBoys/$(request.auth.uid)).data.active == true);
      allow update: if isAdmin() ||
        (signedIn()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status == 'Awaiting customer confirmation'
          && request.resource.data.status == 'Delivered'
          && request.resource.data.customerConfirmedDelivery == true
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'customerConfirmedDelivery', 'customerConfirmedAt', 'updatedAt'])) ||
        (signedIn() &&
          resource.data.deliveryBoyUid == request.auth.uid &&
          exists(/databases/$(database)/documents/deliveryBoys/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/deliveryBoys/$(request.auth.uid)).data.active == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'deliveryLatitude', 'deliveryLongitude', 'deliveryLocationUpdatedAt', 'deliveryLocationActive', 'deliveryLocationEndedAt']) &&
          request.resource.data.status in ['Accepted', 'Preparing', 'Ready', 'Out for delivery', 'Awaiting customer confirmation']) ||
        (signedIn()
          && resource.data.customerUid == request.auth.uid
          && resource.data.status in ['New', 'new', 'Pending', 'pending', 'Accepted', 'accepted', 'Accept', 'accept']
          && request.resource.data.status == 'Cancelled'
          && request.resource.data.cancelledBy == 'customer'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledBy', 'cancelledAt', 'updatedAt']));
      allow delete: if false;
    }
  }
}
